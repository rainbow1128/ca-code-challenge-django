# Copy to .env. Development defaults only; never reuse these values in production.

MAIN_SECRET_KEY=dev-only-main-secret-change-me
AUTH_SECRET_KEY=dev-only-auth-secret-change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

MAIN_PORT=8000
AUTH_PORT=8001

MAIN_DB_NAME=main
MAIN_DB_USER=main
MAIN_DB_PASSWORD=main
AUTH_DB_NAME=auth
AUTH_DB_USER=auth
AUTH_DB_PASSWORD=auth

# WordPress source: the wp-db service (MariaDB loaded from wordpress/db/dump.sql),
# read by the *-wp-import jobs only. WP_PORT is for the optional original site.
WP_DB_ROOT_PASSWORD=root
WP_DB_NAME=wp
WP_DB_USER=wp
WP_DB_PASSWORD=wp
WP_TABLE_PREFIX=wp_
WP_PORT=8080

# Password given to users the auth import creates. Empty = unusable password
# (the user cannot log in until one is set in the auth service).
AUTH_IMPORT_PASSWORD=changeme

# Access tokens (Ed25519-signed JWTs from the auth service). The key pair is
# generated by the jwt-keys compose job into Docker volumes, never into the repo.
JWT_ISSUER=brand-reviews-auth
JWT_AUDIENCE=brand-reviews-main
ACCESS_TOKEN_LIFETIME_SECONDS=900
