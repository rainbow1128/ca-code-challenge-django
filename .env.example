# Copy to .env. Development defaults only; never reuse these values in production.

MAIN_SECRET_KEY=dev-only-main-secret-change-me
AUTH_SECRET_KEY=dev-only-auth-secret-change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

MAIN_PORT=8000
AUTH_PORT=8001

MAIN_DB_NAME=main
MAIN_DB_USER=main
MAIN_DB_PASSWORD=main
AUTH_DB_NAME=auth
AUTH_DB_USER=auth
AUTH_DB_PASSWORD=auth

# WordPress source (read by the *-wp-import jobs only).
# The network is created by the WP compose project; its name comes from that
# project's folder name.
WP_NETWORK_NAME=ca-code-challenge-wordpress_default
WP_DB_HOST=db
WP_DB_PORT=3306
WP_DB_NAME=wp
WP_DB_USER=wp
WP_DB_PASSWORD=wp
WP_TABLE_PREFIX=wp_

# Password given to users the auth import creates. Empty = unusable password
# (the user cannot log in until one is set in the auth service).
AUTH_IMPORT_PASSWORD=changeme
