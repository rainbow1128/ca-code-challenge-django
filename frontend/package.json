{
  "name": "brand-reviews-frontend",
  "private": true,
  "type": "module",
  "description": "SCSS and the React BrandList for the Django main service.",
  "packageManager": "npm@11.6.2",
  "scripts": {
    "build": "npm run build:css && npm run build:js",
    "build:css": "sass --no-source-map --style=compressed scss/main.scss ../main/static/css/main.css",
    "build:js": "vite build",
    "watch:css": "sass --watch --style=expanded scss/main.scss ../main/static/css/main.css",
    "watch:js": "vite build --watch --mode development",
    "check": "npm run check:css && npm run typecheck && npm test",
    "check:css": "node scripts/check-css.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.2.0",
    "jsdom": "27.4.0",
    "sass": "1.101.7",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": ">=22.12",
    "npm": "11.6.2"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8"
  }
}
